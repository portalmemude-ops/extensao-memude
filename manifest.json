{
  "manifest_version": 3,
  "name": "MeMude - WhatsApp to Sheets",
  "version": "1.0.0",
  "description": "Extraia contatos do WhatsApp Web e exporte automaticamente para Google Sheets",
  "key": "",
  "permissions": [
    "storage",
    "identity",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://sheets.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "utils/logger.js",
        "utils/phone-utils.js",
        "utils/phone-extractor.js",
        "content/overlay.js",
        "content/content.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "capture-current": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capturar contato do chat aberto e enviar"
    },
    "open-overlay": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Command+Shift+Y"
      },
      "description": "Abrir o painel MeMude no WhatsApp"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}