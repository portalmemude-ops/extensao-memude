{
  "manifest_version": 3,
  "name": "MeMude Connect · WhatsApp",
  "version": "2.3.1",
  "description": "Cadastre leads, agende visitas e acompanhe a ficha do cliente no MeMude Connect direto do WhatsApp Web",
  "key": "",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://oxybasvtphosdmlmrfnb.supabase.co/*",
    "https://core.memudecore.com.br/*",
    "https://memude-connect.vercel.app/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "utils/config.js",
        "utils/logger.js",
        "utils/phone-utils.js",
        "utils/fontes.js",
        "utils/phone-extractor.js",
        "content/overlay.js",
        "content/content.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://core.memudecore.com.br/*",
        "https://memude-connect.vercel.app/*"
      ],
      "js": [
        "content/connect-sso.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "capture-current": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capturar o contato da conversa aberta para a lista"
    },
    "open-overlay": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Command+Shift+Y"
      },
      "description": "Abrir o painel MeMude Connect no WhatsApp"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "MeMude Connect"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
